# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ai_writing_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://sovereign.com,https://www.sovereign.com

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@sovereign.com
CONTACT_FORM_EMAIL=support@sovereign.com
API_CONTACT_EMAIL=support@sovereign.com

# URLs
FRONTEND_URL=http://localhost:3000
SITE_URL=https://sovereign.com

# Polar
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
POLAR_CUSTOMER_PORTAL_URL=https://polar.sh/portal
POLAR_PRO_MONTHLY_PRODUCT_ID=your-polar-pro-product-id

# Groq API - Primary key
GROQ_API_KEY=your-primary-groq-api-key
GROQ_MODEL=mixtral-8x7b-32768

# Additional Groq API keys for load balancing (optional)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# ... up to GROQ_API_KEY_10

# AI Service Configuration
USE_ASYNC_AI=True
AI_CACHE_TTL=86400
AI_MAX_RETRIES=3
AI_TIMEOUT=30

# Optional fallback LLM providers (Sovereign Agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Agentic AI runtime
AGENTS_DEFAULT_PROVIDER=groq
AGENTS_PLANNER_MODEL=llama-3.3-70b-versatile
AGENTS_FALLBACK_PROVIDERS=openai,anthropic,ollama
AGENTS_MAX_STEPS=6
AGENTS_TOOL_TIMEOUT=45
AGENTS_ENABLE_MODERATION=true
AGENTS_FREE_TIER_DAILY_LIMIT=30
AGENTS_PRO_TIER_DAILY_LIMIT=1000

# Observability
SENTRY_DSN=

# Logging
DJANGO_LOG_LEVEL=INFO

# Marketplace
MARKETPLACE_SUBMISSIONS_ENABLED=True

# Agents
AGENT_ENCRYPTION_KEY=change-this-in-production
AGENT_MAX_STEPS_PER_RUN=25
AGENT_DEFAULT_TIMEOUT_SECONDS=90