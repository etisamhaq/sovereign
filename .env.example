# Database
DB_NAME=aiwriting_dev
DB_USER=aiwriting
DB_PASSWORD=devpassword123
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/1

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI Configuration (primary)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Agent control plane (workspaces, workflows, marketplace) ──────────
# Used by the existing agents app for connector encryption and run limits.
AGENT_ENCRYPTION_KEY=change-this-in-production
AGENT_MAX_STEPS_PER_RUN=25
AGENT_DEFAULT_TIMEOUT_SECONDS=90

# ── Agent chat runtime (streaming chat, multi-LLM router) ─────────────
# Optional fallback LLM providers — leave blank to use Groq only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

AGENTS_DEFAULT_PROVIDER=groq
AGENTS_PLANNER_MODEL=llama-3.3-70b-versatile
AGENTS_FALLBACK_PROVIDERS=openai,anthropic,ollama
AGENTS_MAX_STEPS=6
AGENTS_TOOL_TIMEOUT=45
AGENTS_ENABLE_MODERATION=true
AGENTS_FREE_TIER_DAILY_LIMIT=30
AGENTS_PRO_TIER_DAILY_LIMIT=1000

# Observability (optional)
SENTRY_DSN=

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
DEFAULT_FROM_EMAIL=noreply@sovereign.com

# Stripe Configuration
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Frontend
REACT_APP_API_URL=http://localhost:8000/api