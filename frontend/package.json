  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|react-markdown|remark-.+|rehype-.+|micromark|micromark-.+|decode-named-character-reference|character-entities|property-information|hast-util-.+|html-url-attributes|mdast-util-.+|space-separated-tokens|comma-separated-tokens|unist-util-.+|unified|bail|is-plain-obj|trough|vfile|vfile-message|trim-lines|estree-util-.+|hastscript|trough|web-namespaces|zwitch|ccount|markdown-table|longest-streak|escape-string-regexp|stringify-entities|character-reference-invalid|is-decimal|is-hexadecimal|is-alphanumerical|is-alphabetical|parse-entities|character-entities-html4|character-entities-legacy|github-slugger|devlop|react-router|react-router-dom|@remix-run|set-cookie-parser|cookie|turbo-stream)/)"
    ],
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^react-markdown$": "<rootDir>/src/__mocks__/reactMarkdown.tsx",
      "^remark-gfm$": "<rootDir>/src/__mocks__/remarkGfm.ts"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6"
  }
}
